# =====================================================================
# PAX Cookbook .gitignore
#
# Safe-by-default for the PUBLIC repository. Everything that is build
# output, developer/internal state, machine-specific, or large binary
# is excluded. Only source, configuration, public docs, and the
# resolved-include runtime assets are tracked.
# =====================================================================

# ---- Internal development / dev-trio state (never public) ----
_temp/
_backup/
_archive/
memory/
AGENTS.md
.claude/
Agency-Cowork/
.agency-tools/
notify_brian.ps1
.github/agents/
.github/instructions/
.github/prompts/
.github/copilot-instructions.md
.copilot-bridge/

# ---- Internal admin / dev tooling (never public) ----
# tools/admin holds dev-trio handoff, managed-engine update and
# script-compatibility tooling; tools/guards holds internal governance
# enforcement; neither directory may ship in the public repo.
# tools/entra (product helpers) and tools/release (payload builds) stay tracked.
tools/admin/
tools/guards/

# ---- .NET build output (contains machine-specific absolute paths) ----
**/bin/
**/obj/
[Bb]in/
[Oo]bj/

# ---- Release / packaging artifacts (built, large, machine-stamped) ----
artifacts/
dist/
temp/
/PAX_Cookbook_Setup.exe
*.log
$shim

# ---- React / Node build output + dependencies ----
node_modules/
**/node_modules/
app/web-react/dist/

# ---- Staged runtime (.NET binaries — shipped via the installer, not git) ----
app/bin/

# ---- Install-time runtime directories ----
Backups/
stage/
PreviousVersions/
Logs/
/Logs/

# ---- IDE / user-specific ----
.vs/
.idea/
*.user
*.suo
*.userprefs

# ---- Secrets / environment / signing material (must never be committed) ----
.env
.env.*
*.pfx
*.snk
*.p12
secrets.json
appsettings.*.local.json
.dev-trio/wizard-progress.json

# Dev-Trio scaffolded files
# Remove entries below if your team wants to share
# these configurations across the repo.

# Agent role definitions (GitHub Copilot)
copilot-instructions.md
.github/agents/
constraints.instructions.md
dev-trio.prompt.md

# Agent role definitions (Claude Code)
.claude/agents/
.claude/commands/dt-upgrade.md

# Agent role definitions (Codex)
.codex/agents/

# Per-developer project memory (always keep ignored)
memory/MEMORY.md
memory/ROADMAP.md
memory/PROMPT_EXAMPLES.md

# Dev-Trio internal state
.dev-trio/
