    <Compile Include="..\PAXCookbookSetup\Service\ServiceDisableProtocol.cs"
             Link="Linked\Service\ServiceDisableProtocol.cs" />
    <Compile Include="..\PAXCookbookSetup\Service\ServiceOwnershipElevatedProtocol.cs"
