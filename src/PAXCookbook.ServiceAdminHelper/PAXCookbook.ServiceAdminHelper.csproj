    <Compile Include="..\PAXCookbookSetup\Service\ServiceAdminHelperLocationResolver.cs"
             Link="Linked\Service\ServiceAdminHelperLocationResolver.cs" />
    <Compile Include="..\PAXCookbookSetup\Service\ServiceEnableProtocol.cs"
